{
  "name": "pir",
  "version": "0.2.0",
  "description": "Pi-based code review engine with Repository Memory — local CLI, Pi extension (/review-* commands), and an agent-friendly HTTPS service (pir serve) that reviews even unpushed code via git bundles",
  "type": "module",
  "bin": {
    "pir": "dist/cli/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "skills",
    "docs/for-llm.md"
  ],
  "pi": {
    "extensions": [
      "./dist/extension/index.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beiyanpiki/pir.git"
  },
  "homepage": "https://github.com/beiyanpiki/pir#readme",
  "bugs": {
    "url": "https://github.com/beiyanpiki/pir/issues"
  },
  "author": "Xin Gao",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "code-review",
    "agent-tools"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "node -e \"if (require('node:fs').existsSync('tsconfig.json')) process.exit(1)\" || npm run build",
    "pretest": "npm run build",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke:cli": "node dist/cli/cli.js --help"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
